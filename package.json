{
  "name": "garden-seed-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "promote-admin": "npx tsx scripts/promote-admin.ts",
    "catalog:import": "tsx scripts/catalog/import.ts",
    "test:catalog": "node --import tsx --test tests/catalog/*.test.ts",
    "test:email": "node --test tests/email/*.test.mjs",
    "test:security": "node --import tsx --test tests/security/*.test.ts",
    "test:users": "node --import tsx --test tests/users/*.test.ts",
    "test:reminders": "node --import tsx --test tests/reminders/*.test.ts",
    "test:swap": "node --import tsx --test tests/swap/*.test.ts",
    "db:deploy": "tsx scripts/database/initialize.ts",
    "catalog:import-api": "tsx scripts/catalog/import-api.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.6.0",
    "suncalc": "^1.9.0",
    "zod": "^3.22.4",
    "prisma": "6.19.3",
    "tsx": "^4.23.13"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.3.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
